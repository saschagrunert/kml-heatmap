*.kml
!data/*.kml
# Temp files of an interrupted obfuscation run hold the original dates
data/.*.tmp
/index.html
AGENTS.md
.playwright-mcp

# Generated sites, never committed: docs/ is the default OUTPUT_DIR of
# `make build`, out/ the output of the README examples and site/ the one the
# deploy job publishes.
/docs/
/out/
/site/

# Python
__pycache__
*.pyc
*.egg-info/
.venv/
venv/
.mypy_cache
.ruff_cache
.pytest_cache/
.hypothesis/
dist/
build/

# Node
node_modules

# Test coverage reports
.coverage
.coverage.*
coverage.xml
coverage
htmlcov

# Playwright test results
test-results/
playwright-report/

# Test data
kml_test_*

# JavaScript build artifacts (generated by esbuild from kml_heatmap/frontend/)
kml_heatmap/static/mapApp.bundle.js
kml_heatmap/static/features.bundle.js
kml_heatmap/static/*.map
# Third-party files copied out of node_modules by scripts/vendor.js
kml_heatmap/static/vendor/
kml_heatmap/static/flags/
.claude/
